# ストア提出要件（公開情報ベース）。期限切れ前に Claude が公式ページで再確認して更新する。
# RULES_CHECKED が 90 日以上前なら SKILL.md の「ルール更新」手順を自動実行すること。
RULES_CHECKED=2026-09-29

# Google Play: 2026-08-31 以降、新規/更新は API 36 以上（延長申請で 2026-11-01 まで）
# https://developer.android.com/google/play/requirements/target-sdk
PLAY_MIN_TARGET_SDK=36
# Google Play: 2025-11-01 以降、Android 15+ 向け新規/更新は 16KB ページ対応必須。Flutter 3.32+ で対応
# https://android-developers.googleblog.com/2025/05/prepare-play-apps-for-devices-with-16kb-page-size.html
MIN_FLUTTER_16KB=3.32
# Firebase Android BoM 33+ / firebase_auth は minSdk 23 必須
# https://pub.dev/packages/firebase_core/changelog
FIREBASE_MIN_SDK=23
# versionCode 上限（Play）
PLAY_MAX_VERSION_CODE=2100000000

# App Store: 2026-04-28 以降、Xcode 26 + iOS 26 SDK でビルドしたもののみアップロード可
# https://developer.apple.com/news/upcoming-requirements/
APPLE_MIN_XCODE=26
