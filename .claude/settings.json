{
  "name": "yourwish - Claude Code Docker Setup",
  "description": "SNS配信ゲーム・パズルゲーム開発用モノレポ（Docker永続化・リソース最適化対応）",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "Artifact",
      "Agent",
      "Workflow",
      "SendMessage",
      "mcp__Claude_Code_Remote__*",
      "mcp__github__*",
      "mcp__Gmail__*",
      "mcp__Google_Drive__*",
      "*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
      }
    ],
    "on_session_start": {
      "description": "セッション開始時に Docker セットアップを自動実行",
      "script": ".claude/hooks/on-session-start.sh",
      "runImmediately": true
    },
    "on_build_complete": {
      "description": "ビルド完了後の自動テスト実行",
      "script": ".claude/hooks/on-build-complete.sh",
      "trigger": "post-build"
    }
  },
  "docs": {
    "primary": "CLAUDE.md",
    "additional": [
      "README.md",
      "docs/sns-live-game-environments.md",
      "docs/LOCAL_ENV_FREE_BUILD.md",
      "docs/orchestrator-architecture.md"
    ],
    "sessionStart": ".claude/SessionStart.md"
  },
  "recommendations": {
    "docker": {
      "enabled": true,
      "composePath": "docker-compose.yml",
      "autoSetup": true,
      "message": "このプロジェクトは完全な Docker 統合ビルド環境対応です。ローカル SDK 不要で ./scripts/build.sh でビルド完結します。"
    },
    "tools": [
      {
        "name": "build-script",
        "path": "scripts/build.sh",
        "description": "統一ビルドスクリプト - Docker 内で完全にビルド完結",
        "usage": "./scripts/build.sh flutter | android | web | packages"
      }
    ],
    "skills": [
      {
        "name": "docker-claude-setup",
        "description": "Docker リソース節約セットアップ",
        "location": ".claude/skills/docker-claude-setup/SKILL.md"
      },
      {
        "name": "session-start-hook",
        "description": "セッション開始フック（自動初期化）",
        "location": ".claude/hooks/on-session-start.sh"
      },
      {
        "name": "build-and-test",
        "description": "ビルド完了後の自動エミュレータテスト（起動・連携・購入・認証・広告）",
        "location": ".claude/skills/build-and-test/SKILL.md"
      }
    ]
  },
  "environment": {
    "NODE_VERSION": "20",
    "SUPPORTS_DOCKER": true,
    "AUTO_SETUP": true
  },
  "paths": {
    "scripts": "scripts/",
    "apps": "apps/",
    "packages": "packages/",
    "docs": "docs/"
  },

  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__create_session",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__set_session_title",
      "mcp__Claude_Code_Remote__set_session_tags",
      "mcp__Claude_Code_Remote__archive_session",
      "mcp__Claude_Code_Remote__unarchive_session",
      "mcp__Claude_Code_Remote__interrupt_session",
      "mcp__Claude_Code_Remote__list_environments",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__watch_url",
      "mcp__Claude_Code_Remote__unwatch_url",
      "mcp__Claude_Code_Remote__*"
    ]
  }
}