# Claude Code Docker リソース設定
# このファイルを .env にコピーして、環境に合わせて編集してください

# ===== Node.js メモリ設定 =====
# Node.js の最大メモリ（デフォルト: 512MB）
# 低スペック環境: 256, 通常: 512, 高スペック: 1024+
NODE_MAX_MEMORY=512

# ===== Docker リソース制限 =====
# CPU 制限（コア数、デフォルト: 2.0）
# 例: 1.0 = 1コア全消費, 0.5 = 1コアの50%
CLAUDE_CPU_LIMIT=2.0

# メモリ制限（デフォルト: 1G）
# 低スペック: 512M, 中程度: 1G, 高: 2G
CLAUDE_MEMORY_LIMIT=1G

# 予約メモリ（最小保証）
CLAUDE_MEMORY_RESERVE=512M

# CPU 予約（最小保証）
CLAUDE_CPU_RESERVE=1.0

# ===== npm 設定 =====
# オフラインモードを有効化（キャッシュ活用）
# true: キャッシュのみ使用（ネットワーク不要）, false: ネットワーク接続時に更新
npm_config_prefer_offline=true

# npm キャッシュディレクトリ（デフォルト: /home/node/.npm）
# 変更しない推奨
# npm_config_cache=/home/node/.npm

# ===== 推奨設定 =====
# 【低スペック環境】(2GB RAM以下)
# NODE_MAX_MEMORY=256
# CLAUDE_CPU_LIMIT=1.0
# CLAUDE_MEMORY_LIMIT=512M
# CLAUDE_MEMORY_RESERVE=256M
# CLAUDE_CPU_RESERVE=0.5

# 【中程度環境】(4GB RAM)
# NODE_MAX_MEMORY=512
# CLAUDE_CPU_LIMIT=2.0
# CLAUDE_MEMORY_LIMIT=1G
# CLAUDE_MEMORY_RESERVE=512M
# CLAUDE_CPU_RESERVE=1.0

# 【高スペック環境】(8GB以上)
# NODE_MAX_MEMORY=1024
# CLAUDE_CPU_LIMIT=4.0
# CLAUDE_MEMORY_LIMIT=2G
# CLAUDE_MEMORY_RESERVE=1G
# CLAUDE_CPU_RESERVE=2.0

# ===== ビルド設定 =====
# ビルドモード (debug/release)
BUILD_MODE=release

# Flutter バージョン
FLUTTER_VERSION=3.24.0

# Dart バージョン
DART_VERSION=3.12.0

# Docker イメージレジストリ
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=zka32101

# ===== CI/CD 設定 =====
# CI/CD 環境フラグ
CI=false

# ビルド対象アプリ（複数可: vote_survivor,prefecture_defense,sns_game_template）
BUILD_TARGETS=vote_survivor

# GitHub Actions アーティファクト保持期間（日数）
ARTIFACT_RETENTION_DAYS=7

# ===== 本番環境設定 =====
# 本番環境フラグ
ENVIRONMENT=development

# ログレベル (debug/info/warn/error)
LOG_LEVEL=info

# タイムゾーン
TZ=Asia/Tokyo
