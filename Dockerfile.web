# Flutter Web アプリ用マルチステージビルド
#
# 使用例:
#   docker build -t yourwish-web:latest -f Dockerfile.web .
#   docker run -p 8080:80 yourwish-web:latest

# ========================
# ステージ1: Flutter ビルド環境
# ========================
FROM cirrusci/flutter:3.24.0 as builder

WORKDIR /workspace

# ビルド対象アプリの指定（引数で変更可能）
ARG APP_NAME=vote_survivor
ARG BUILD_MODE=release

# 依存関係をインストール
COPY . .
WORKDIR /workspace/apps/${APP_NAME}

# Flutter 依存関係をインストール
RUN flutter pub get

# Web ビルド実行
RUN flutter build web --${BUILD_MODE}

# ========================
# ステージ2: nginx サーバー
# ========================
FROM nginx:alpine

LABEL maintainer="yourwish-team"
LABEL description="Flutter Web app server (nginx)"

# デフォルト設定を削除
RUN rm /etc/nginx/conf.d/default.conf

# カスタム nginx 設定をコピー
COPY << 'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    client_max_body_size 20M;
    gzip on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss;
    gzip_min_length 1024;

    # SPA ルーティング設定
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;

        # キャッシュ設定（開発用：短期）
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options "nosniff";
        add_header X-Frame-Options "SAMEORIGIN";
    }

    # 静的アセット（長期キャッシュ）
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
    }

    # HealthCheck エンドポイント
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # セキュリティヘッダー設定
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
EOF

# ステージ1 からビルド成果物をコピー
COPY --from=builder /workspace/apps/vote_survivor/build/web /usr/share/nginx/html/

WORKDIR /usr/share/nginx/html

EXPOSE 80

# ヘルスチェック
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# nginx フォアグラウンド実行
CMD ["nginx", "-g", "daemon off;"]
