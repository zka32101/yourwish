rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ランキング - 誰でも読み取り可能（Cloud Functions から書き込み）
    match /rankings/{prefecture} {
      allow read: if true;
      allow write: if false;

      match /entries/{entry=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ユーザープロフィール - 本人のみ
    match /user_profiles/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }

    // デイリーボーナス - 本人のみ（Cloud Functions から書き込み）
    match /daily_bonuses/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if false;
    }
  }
}
