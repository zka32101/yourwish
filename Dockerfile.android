# Android APK ビルド用マルチステージDockerfile
#
# 使用例:
#   docker build -t yourwish-android:latest -f Dockerfile.android .
#   docker run --rm -v $(pwd)/build:/workspace/build yourwish-android:latest

# ========================
# ステージ1: Android SDK + Flutter ビルド環境
# ========================
FROM cirrusci/flutter:3.24.0 as builder

LABEL maintainer="yourwish-team"
LABEL description="Android APK builder (Flutter)"

ENV ANDROID_SDK_ROOT /opt/android-sdk
ENV ANDROID_HOME /opt/android-sdk
ENV GRADLE_USER_HOME /root/.gradle
ENV PATH ${PATH}:${ANDROID_SDK_ROOT}/platform-tools:${ANDROID_SDK_ROOT}/tools

WORKDIR /workspace

# ビルドパラメータ
ARG APP_NAME=vote_survivor
ARG BUILD_MODE=release
ARG ENABLE_PROGUARD=true

# Gradle キャッシュボリューム設定
VOLUME ["/root/.gradle", "/workspace/.build-cache"]

# 依存関係をインストール
COPY . .

WORKDIR /workspace/apps/${APP_NAME}

# Flutter キー設定（CI/CD用）
RUN if [ -n "$SIGNING_KEY_PATH" ]; then \
      cp ${SIGNING_KEY_PATH} android/app/; \
    fi

# Flutter 依存関係をインストール
RUN flutter pub get

# Android APK ビルド
RUN flutter build apk \
    --${BUILD_MODE} \
    $([ "$ENABLE_PROGUARD" = "true" ] && echo "--obfuscate --split-debug-info=build/debug-info" || echo "")

# ビルド成果物をディレクトリに整理
RUN mkdir -p /output && \
    cp build/app/outputs/apk/${BUILD_MODE}/*.apk /output/ || true && \
    cp build/app/outputs/apk/release/*.aab /output/ || true

# ========================
# ステージ2: 出力イメージ（成果物のみ）
# ========================
FROM alpine:3.18 as output

LABEL maintainer="yourwish-team"
LABEL description="Android APK output"

COPY --from=builder /output /output

WORKDIR /output

# APK のメタデータ表示
RUN if ls *.apk 2>/dev/null; then \
      echo "=== Android APK ビルド成功 ===" && \
      ls -lh *.apk && \
      echo "" && \
      echo "署名検証:" && \
      apk add --no-cache jarsigner 2>/dev/null || echo "(署名検証スキップ)" ; \
    fi

CMD ["sh", "-c", "echo 'APK files available in /output' && ls -lh /output/*.apk 2>/dev/null || echo 'No APK found'"]
